rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile and top-level settings
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Transactions collection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId);
        allow update: if isOwner(userId) && isValidId(transactionId);
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // Categories collection
      match /categories/{categoryId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(categoryId);
      }

      // Recycle bin / recoverable deleted items
      match /trash/{trashId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(trashId);
      }

      // Accounts / Wallets collection
      match /accounts/{accountId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(accountId);
        allow update: if isOwner(userId) && isValidId(accountId);
        allow delete: if isOwner(userId) && isValidId(accountId);
      }

      // Persons / Due tracking collection
      match /persons/{personId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(personId);
        allow update: if isOwner(userId) && isValidId(personId);
        allow delete: if isOwner(userId) && isValidId(personId);
      }

      // Budgets collection
      match /budgets/{budgetId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(budgetId);
        allow update: if isOwner(userId) && isValidId(budgetId);
        allow delete: if isOwner(userId) && isValidId(budgetId);
      }

      // Savings collection
      match /savings/{savingsId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(savingsId);
        allow update: if isOwner(userId) && isValidId(savingsId);
        allow delete: if isOwner(userId) && isValidId(savingsId);
      }

      // Tasks collection
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId);
        allow update: if isOwner(userId) && isValidId(taskId);
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // Notes / Memos collection
      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(noteId);
        allow update: if isOwner(userId) && isValidId(noteId);
        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      // Recurring transactions collection
      match /recurring/{recurringId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(recurringId);
        allow update: if isOwner(userId) && isValidId(recurringId);
        allow delete: if isOwner(userId) && isValidId(recurringId);
      }

      // Shared mess and mill records
      match /mess_records/{recordId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(recordId);
        allow update: if isOwner(userId) && isValidId(recordId);
        allow delete: if isOwner(userId) && isValidId(recordId);
      }
    }
  }
}
